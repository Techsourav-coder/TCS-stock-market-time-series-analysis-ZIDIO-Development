# Step 1: Import necessary libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import MinMaxScaler
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout

# Step 2: Load the dataset
df = pd.read_csv('TCS Historical Data.csv')

# Step 3: Clean and prepare the 'Price' column
df.columns = [col.strip() for col in df.columns]
df['Date'] = pd.to_datetime(df['Date'])
df = df.sort_values('Date')
df['Price'] = df['Price'].astype(str).str.replace(',', '').str.strip()
df['Price'] = pd.to_numeric(df['Price'], errors='coerce')

# Step 4: Filter and interpolate missing data
data = df[['Date', 'Price']].dropna()
data.set_index('Date', inplace=True)
data = data.asfreq('D')  # Use daily frequency
data['Price'] = data['Price'].interpolate()  # Fill missing days

# Step 5: Normalize the 'Price' values
scaler = MinMaxScaler(feature_range=(0, 1))
scaled_data = scaler.fit_transform(data[['Price']])

# Step 6: Create sequences for LSTM input
def create_sequences(data, window_size):
    X, y = [], []
    for i in range(window_size, len(data)):
        X.append(data[i - window_size:i, 0])
        y.append(data[i, 0])
    return np.array(X), np.array(y)

window_size = 60  # Use last 60 days to predict next day
X, y = create_sequences(scaled_data, window_size)

# Step 7: Split into training and testing data (e.g., 80-20 split)
split = int(0.8 * len(X))
X_train, X_test = X[:split], X[split:]
y_train, y_test = y[:split], y[split:]

# Reshape for LSTM input: [samples, time_steps, features]
X_train = X_train.reshape(X_train.shape[0], X_train.shape[1], 1)
X_test = X_test.reshape(X_test.shape[0], X_test.shape[1], 1)

# Step 8: Build the LSTM model
model = Sequential([
    LSTM(50, return_sequences=True, input_shape=(X_train.shape[1], 1)),
    Dropout(0.2),
    LSTM(50, return_sequences=False),
    Dropout(0.2),
    Dense(1)
])

model.compile(optimizer='adam', loss='mean_squared_error')
model.summary()

# Step 9: Train the model
history = model.fit(X_train, y_train, epochs=20, batch_size=32, validation_data=(X_test, y_test))

# Step 10: Predict on test data
predicted_prices = model.predict(X_test)
predicted_prices = scaler.inverse_transform(predicted_prices.reshape(-1, 1))

# Step 11: Inverse scale actual values
actual_prices = scaler.inverse_transform(y_test.reshape(-1, 1))

# Step 12: Plot actual vs predicted
plt.figure(figsize=(12, 6))
plt.plot(actual_prices, label='Actual Price')
plt.plot(predicted_prices, label='Predicted Price')
plt.title('TCS Stock Price Prediction with LSTM')
plt.xlabel('Days')
plt.ylabel('Price (₹)')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()

# Step 13: Future forecast (e.g., next 30 days)
last_sequence = scaled_data[-window_size:]
future_prices = []

for _ in range(30):  # Predict next 30 days
    input_seq = last_sequence.reshape(1, window_size, 1)
    pred = model.predict(input_seq)[0, 0]
    future_prices.append(pred)
    last_sequence = np.append(last_sequence[1:], [[pred]], axis=0)

# Inverse scale future predictions
future_prices = scaler.inverse_transform(np.array(future_prices).reshape(-1, 1))

# Step 14: Plot future forecast
plt.figure(figsize=(10, 5))
plt.plot(future_prices, label='Next 30 Days Forecast')
plt.title('TCS Stock Price - Future Forecast (LSTM)')
plt.xlabel('Days Ahead')
plt.ylabel('Price (₹)')
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()
