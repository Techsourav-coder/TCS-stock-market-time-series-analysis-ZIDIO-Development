model = Prophet(
    yearly_seasonality=True,  # Enable yearly pattern
    weekly_seasonality=False,
    daily_seasonality=False,
    seasonality_mode='additive'  # Can change to 'multiplicative' if trend increases with value
)

# Step 8: Fit the model on historical data
model.fit(df_prophet)

# Step 9: Create future dataframe (e.g., forecast next 12 months = 365 days)
