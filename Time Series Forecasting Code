# Step 1: Import required libraries
import pandas as pd
import matplotlib.pyplot as plt
from prophet import Prophet

# Step 2: Load the TCS dataset
df = pd.read_csv('TCS Historical Data.csv')

# Step 3: Clean column names and fix data types
df.columns = [col.strip() for col in df.columns]  # remove extra spaces
df['Date'] = pd.to_datetime(df['Date'])           # convert to datetime
df = df.sort_values('Date')                       # sort ascending by date

# Step 4: Clean 'Price' column (remove commas, handle non-numeric)
df['Price'] = df['Price'].astype(str).str.replace(',', '').str.strip()
df['Price'] = pd.to_numeric(df['Price'], errors='coerce')

# Step 5: Prepare data for Prophet
# Prophet expects two columns: 'ds' (datetime) and 'y' (value to forecast)
df_prophet = df[['Date', 'Price']].rename(columns={'Date': 'ds', 'Price': 'y'})
df_prophet = df_prophet.dropna()

# Step 6: Visualize the time series
plt.figure(figsize=(12,5))
plt.plot(df_prophet['ds'], df_prophet['y'])
plt.title('TCS Stock Price Over Time')
plt.xlabel('Date')
plt.ylabel('Price (₹)')
plt.grid(True)
plt.tight_layout()
plt.show()

