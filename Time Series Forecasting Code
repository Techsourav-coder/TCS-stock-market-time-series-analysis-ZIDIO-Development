import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.arima.model import ARIMA

# Step 1: Load the Excel file
file_path = 'yahoo_data.xlsx'
df = pd.read_excel(file_path)

# Step 2: Show available columns
print("Available columns:", df.columns.tolist())

# Step 3: Detect the 'Close' column automatically
close_col = None
for col in df.columns:
    if 'close' in col.lower():
        close_col = col
        break

if close_col is None:
    raise ValueError("No 'Close' column found. Please check the column headers.")

print(f"Using '{close_col}' as the Close column.")

# Step 4: Convert 'Date' to datetime and sort
df['Date'] = pd.to_datetime(df['Date'])
df = df.sort_values('Date')
df.set_index('Date', inplace=True)
df = df.asfreq('MS')  # Monthly Start frequency

# Step 5: Prepare the time series
ts = df[close_col].dropna()

# Step 6: Plot original series
plt.figure(figsize=(12, 5))
plt.plot(ts, label='Monthly Close Price')
plt.title('Stock Monthly Close Price (Yahoo Data)')
plt.xlabel('Date')
plt.ylabel('Price')
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()

# Step 7: Fit ARIMA model
model = ARIMA(ts, order=(1, 1, 1))  # You can tune (p,d,q)
results = model.fit()
print(results.summary())

# Step 8: Forecast next 12 months
forecast = results.get_forecast(steps=12)
forecast_df = forecast.summary_frame()

# Step 9: Plot forecast
plt.figure(figsize=(12, 5))
plt.plot(ts, label='Observed')
plt.plot(forecast_df['mean'], label='Forecast', color='green')
plt.fill_between(forecast_df.index,
                 forecast_df['mean_ci_lower'],
                 forecast_df['mean_ci_upper'],
                 color='lightgreen', alpha=0.4)
plt.title("Stock Price Forecast (ARIMA Model)")
plt.xlabel('Date')
plt.ylabel('Price')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()

