import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.statespace.sarimax import SARIMAX

# Step 1: Load and clean data
df = pd.read_csv('TCS Historical Data.csv')
df.columns = [col.strip() for col in df.columns]
df['Date'] = pd.to_datetime(df['Date'])
df = df.sort_values('Date')
df.set_index('Date', inplace=True)
df = df.asfreq('MS')  # Monthly frequency

# Step 2: Clean 'Price' column
df['Price'] = df['Price'].astype(str).str.replace(',', '').str.strip()
df['Price'] = pd.to_numeric(df['Price'], errors='coerce')
ts = df['Price'].dropna()

# Step 3: Plot full time series
plt.figure(figsize=(12, 5))
plt.plot(ts, label='Historical Price')
plt.title('TCS Monthly Price - Full Series')
plt.xlabel('Date')
plt.ylabel('Price (₹)')
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()

# Step 4: Fit SARIMA model (Seasonal ARIMA)
# Order = (p,d,q), Seasonal_Order = (P,D,Q,s) where s=12 for monthly seasonality
model = SARIMAX(ts, order=(1, 1, 1), seasonal_order=(1, 1, 1, 12))
results = model.fit()
print(results.summary())

# Step 5: Forecast next 12 months (or more)
n_steps = 12  # Change to 24 for 2 years
forecast = results.get_forecast(steps=n_steps)
forecast_df = forecast.summary_frame()

# Step 6: Plot forecast
plt.figure(figsize=(12, 5))
plt.plot(ts, label='Observed')
plt.plot(forecast_df['mean'], label=f'{n_steps}-Month Forecast', color='green')
plt.fill_between(forecast_df.index,
                 forecast_df['mean_ci_lower'],
                 forecast_df['mean_ci_upper'],
                 color='lightgreen', alpha=0.4)
plt.title(f"TCS Stock Price Forecast ({n_steps} Months) - SARIMA")
plt.xlabel('Date')
plt.ylabel('Price (₹)')
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()

