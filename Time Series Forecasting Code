# Step 1: Import Required Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from statsmodels.tsa.stattools import adfuller
from sklearn.model_selection import train_test_split

# Step 2: Load Stock Data (from Excel)
file_path = "yahoo_data.xlsx"  # Update path as needed
df = pd.read_excel(file_path)

# Step 3: File Paths and Load Datasets
df.rename(columns=lambda x: x.strip().replace('*', '').replace('**', ''), inplace=True)
df['Date'] = pd.to_datetime(df['Date'])
df.set_index('Date', inplace=True)
df.sort_index(inplace=True)

# Step 4: Returns & Log Returns
df['Returns'] = df['Close'].pct_change()
df['Log_Returns'] = np.log(df['Close'] / df['Close'].shift(1))

# Step 5: ADF Stationarity Test
def adf_test(series, title=''):
    result = adfuller(series.dropna(), autolag='AIC')
    print(f'ADF Test for {title}')
    print(f'Statistic: {result[0]:.4f}')
    print(f'p-value: {result[1]:.4f}')
    print(f'Lags Used: {result[2]}')
    print(f'Critical Values:')
    for key, value in result[4].items():
        print(f'   {key}: {value:.4f}')
    print('Stationary' if result[1] < 0.05 else 'Non-Stationary', end='\n\n')

adf_test(df['Returns'], 'Daily Returns')
adf_test(df['Log_Returns'], 'Log Returns')

# Step 6: Train-Test Split
train, test = train_test_split(df, test_size=0.2, shuffle=False)

# Step 7: Moving Average Plotting
plt.figure(figsize=(12, 6))
df['Close'].plot(label='Close Price', alpha=0.5)
df['Close'].rolling(window=20).mean().plot(label='20-Day MA')
df['Close'].rolling(window=50).mean().plot(label='50-Day MA')
plt.title('Moving Averages of Close Price')
plt.legend()
plt.tight_layout()
plt.show()

# Step 8: Run EDA for All Datasets
plt.figure(figsize=(14, 8))
sns.histplot(df['Returns'].dropna(), bins=50, kde=True)
plt.title('Distribution of Returns')
plt.show()

sns.heatmap(df.corr(), annot=True, cmap='coolwarm')
plt.title('Correlation Heatmap')
plt.show()

# Step 9: Confirm Execution
print("✔️ All steps executed successfully.")


